<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- the parse helpers of the example-based suite, shared by link so
         the two suites cannot drift on how a test input is parsed -->
    <Compile Include="..\FSharp.Refactor.Tests\Parsing.fs" Link="Parsing.fs" />
    <Compile Include="BoolExpr.fs" />
    <Compile Include="Interpreter.fs" />
    <Compile Include="Programs.fs" />
    <Compile Include="Mutation.fs" />
    <Compile Include="RuleSet.fs" />
    <Compile Include="Typed.fs" />
    <Compile Include="Shapes.fs" />
    <Compile Include="Families\Dictionaries.fs" />
    <Compile Include="Families\Collections.fs" />
    <Compile Include="Families\Matching.fs" />
    <Compile Include="Families\Correctness.fs" />
    <Compile Include="Families\Objects.fs" />
    <Compile Include="Families\Async.fs" />
    <Compile Include="Families\Loops.fs" />
    <Compile Include="Families\Security.fs" />
    <Compile Include="Families\Branching.fs" />
    <Compile Include="Families\Strings.fs" />
    <Compile Include="Families\Declarations.fs" />
    <Compile Include="Families.fs" />
    <Compile Include="RobustnessTests.fs" />
    <Compile Include="BooleanSemanticsTests.fs" />
    <Compile Include="FixTests.fs" />
    <Compile Include="TypedTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageReference Update="FSharp.Core" Version="10.1.201" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FSharp.Refactor.Analyzers\FSharp.Refactor.Analyzers.fsproj" />
  </ItemGroup>

</Project>
