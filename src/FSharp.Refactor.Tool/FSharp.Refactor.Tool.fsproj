<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- LatestMajor, not LatestMinor: type providers erase to the analyzed
         project's RUNTIME references, and a net8 host handed lib/net10.0
         SQLProvider assemblies cannot instantiate them ("SqlDataProvider is
         not defined" on a project that builds cleanly). Running on the
         newest installed runtime lets the tool typecheck projects that
         target it. -->
    <RollForward>LatestMajor</RollForward>
    <!-- ships as a dotnet tool: dotnet tool install fsharp-refactor -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsharp-refactor</ToolCommandName>
    <PackageId>fsharp-refactor</PackageId>
    <Description>Applies the FSharp.Refactor analyzers' quick fixes to F# code from the command line. Point it at a project, a script, a solution, a directory or a glob; --dry-run reports without editing. The tool clarifies the (agent-generated or old) code's intent, reduces non-alphanumeric noise, and uses built-in .NET libraries more efficiently.</Description>
    <PackageReleaseNotes>0.8.57: Edit-mode reports keep each note once across a framework&apos;s passes; console notes key on the surrounding text and column, not the line number. A project whose &lt;Platforms&gt; lacks AnyCPU builds for x64 or its first platform. Errors only FCS&apos;s per-file check reports no longer roll a pass back. A test project is one something runs (test platform or an executable). Repositories pinned to SDK 6 or 7 load. Analyzer fixes as in the analyzers package.

 0.8.56: Reads code with FSharp.Compiler.Service 43.13.404 (FSharp.Analyzers.SDK 0.43), the compiler of FsAutoComplete 0.87.

 0.8.55: Multi-targeted projects are swept narrowest API first by version (net462 before net47, .NET Framework below 4.6.1 before netstandard2.0); a solution without Any CPU builds for x64 or its first platform; redirected output is UTF-8. Analyzer fixes as in the analyzers package.

 0.8.54: --exclude-codes leaves rules out of a run, after --codes and --categories and ahead of fsharprefactor.json; the MCP analyze call takes excludeCodes.

 0.8.53: A compilation that finished keeps its fixes when Ctrl+C or a file error comes before the next framework&apos;s pass. Ctrl+C exits 130, never a stack trace. An empty or comment-only fsharprefactor.json refuses nothing. --mcp answers a refused call with its own reason. A generator&apos;s banner is read at the end of a header line and below an attribute of several lines. A glob ignores case on macOS.

 0.8.52: Reads code with FSharp.Compiler.Service 43.12.402 (FSharp.Analyzers.SDK 0.41), the compiler of FsAutoComplete 0.86.</PackageReleaseNotes>
    <Authors>Tuomas Hietanen</Authors>
    <PackageProjectUrl>https://github.com/Thorium/fsharp-refactor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Thorium/fsharp-refactor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;dotnet-tool;analyzers;refactoring;codefix;static-analysis;code-quality;linter;code-cleanup;sarif;mcp;mcp-server;ai;llm;agents</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <!-- what a .NET Framework script compiles against: the tool runs on the
         net10.0 FSharp.Core, which resolves nothing against mscorlib -->
    <None
      Include="$(PkgFSharp_Core)/lib/netstandard2.0/FSharp.Core.dll"
      Link="netstandard2.0/FSharp.Core.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="FileWalk.fs" />
    <Compile Include="Workspace.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.404" GeneratePathProperty="true" />
    <ProjectReference Include="..\FSharp.Refactor.Analyzers\FSharp.Refactor.Analyzers.fsproj" />
  </ItemGroup>

</Project>
