<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- FSharp.Analyzers.SDK 0.41 supports net10.0 only -->
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet convention for F# analyzers: FSAC/CLI load them from
         analyzers/dotnet/fs. IncludeBuildOutput=false + the explicit None
         packs below keep the dlls FLAT in that folder (BuildOutputTargetFolder
         alone nests them under net10.0/, one directory below the path every
         setup guide tells users to configure). -->
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>FSharp.Refactor.Analyzers</PackageId>
    <Description>Functional refactoring suggestions (light bulb quick fixes) for F#, built on FSharp.Analyzers.SDK. Over 180 rules covering correctness, performance, idiom and redundancy. Suggestions are Hint severity and never gate a build; the priority rules show as warnings in the editor.</Description>
    <PackageReleaseNotes>0.8.54: The fsharp-refactor tool gains --exclude-codes; the analyzers are unchanged.

 0.8.53: A generator&apos;s banner is read at the end of a header line (`module X // generated by ...`) and below an attribute of several lines.

 0.8.52: One build, for FSharp.Analyzers.SDK 0.41 (FsAutoComplete 0.86+, Ionide 8+, fsharp-analyzers 0.41), in analyzers/dotnet/fs; the SDK 0.37 and 0.35 builds are gone, and 0.8.51 is the last release for older hosts.

 0.8.51:A build for FSharp.Analyzers.SDK 0.41 (FsAutoComplete 0.86, Ionide 8, fsharp-analyzers 0.41), and one folder per build: analyzers/dotnet/fs (0.41), fs-sdk0.37, fs-sdk0.35. Point an editor at analyzers/dotnet and the CLI at the folder for its version. The package declares no dependency: FSharp.Compiler.Service and the analyzer SDK landed in the bin of applications referencing it. Prose such as "types generated by JsonProvider" no longer marks a file generated.

 0.8.50: FR0029&apos;s return hoist no longer takes the `elif` links after an awaiting arm as a branch of their own: it put `return` in front of the `elif` keyword, which didn&apos;t compile, and the build check rolled the edit back.

 0.8.49: FR0016 and FR0070 read what takes reference types only (a value, a record literal or a type argument given to it), in the project&apos;s other files and, under --api-changes, the projects referencing the type: [&lt;Struct&gt;] stopped TryAddSingleton compiling.

 0.8.48: New rules FR0183, and FR0184 (off by default): secrets and clients a redirect exposes. New rule FR0185 (off by default): unions with no fields can be structs. FR0016, FR0070, FR0130, FR0131, FR0011, FR0033, FR0026 and FR0132 read past harmless attributes. FR0118 leaves shared and detached work, comparisons and overloads with another return type alone; FR0152 ignores unrelated removals.</PackageReleaseNotes>
    <Authors>Tuomas Hietanen</Authors>
    <PackageProjectUrl>https://github.com/Thorium/fsharp-refactor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Thorium/fsharp-refactor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;analyzers;refactoring;codefix;static-analysis;code-quality;linter;ionide;fsautocomplete</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <!-- analyzers are build-time tools: nothing flows to the consumer's output.
         The host supplies FSharp.Analyzers.SDK, FSharp.Compiler.Service and
         FSharp.Core, so the package declares no dependency: a declared one
         lands in the consumer's bin and raises its FSharp.Core floor. -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- analyzer packages intentionally have no lib/ folder -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <!-- One build, for FSharp.Analyzers.SDK 0.41: FsAutoComplete 0.86+
         (Ionide 8+) and fsharp-analyzers 0.41. The SDK loads only analyzers
         built against its own major.minor. -->
    <None
      Include="bin\$(Configuration)\net10.0\FSharp.Refactor.Analyzers.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/fs"
      Visible="false" />
    <None
      Include="bin\$(Configuration)\net10.0\FSharp.Refactor.Analyzers.xml"
      Pack="true"
      PackagePath="analyzers/dotnet/fs"
      Visible="false" />
    <!-- The symbol package: the pdb is packed beside its dll, and NuGet
         copies every packed pdb into the .snupkg at the same path, where the
         symbol server matches it. Without one the .snupkg has neither
         content nor dependencies and the pack fails (NU5017). -->
    <None
      Include="bin\$(Configuration)\net10.0\FSharp.Refactor.Analyzers.pdb"
      Pack="true"
      PackagePath="analyzers/dotnet/fs"
      Visible="false" />
  </ItemGroup>

