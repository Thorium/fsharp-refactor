<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet convention for F# analyzers: FSAC/CLI load them from
         analyzers/dotnet/fs. IncludeBuildOutput=false + the explicit None
         packs below keep the dlls FLAT in that folder (BuildOutputTargetFolder
         alone nests them under net8.0/, one directory below the path every
         setup guide tells users to configure). -->
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>FSharp.Refactor.Analyzers</PackageId>
    <Description>Functional refactoring suggestions (light bulb quick fixes) for F#, built on FSharp.Analyzers.SDK. Over 130 rules covering correctness, performance, idiom and redundancy; every one is Hint severity, so they never gate a build.</Description>
    <PackageReleaseNotes>0.8.42: FR0075 counts a window the scope does not show modally (`form.Show()`, `Application.Run form`, a method of its own that shows it) as self-active: a `use` there disposed the window on the spot (C# twin CR0060).

 0.8.41: New rules FR0175 (date format `hh`/`mm`/`MM` mix-ups, fix), FR0176 (date parts from two instants, fix), FR0177 (always-true/false comparison pair), FR0178 (`.Value` in the empty branch), FR0179 (discarded immutable update), FR0180 (`Random` per call to `Random.Shared`, fix), FR0181 (specific catch around a blocking wait). FR0067 covers `Convert.To*` on a string, FR0017 `let _ = asyncCall`, FR0127 credential-named literals; reports mask credential findings. FR0049 accepts a read behind a bounded `Task.WaitAny`. Faster sweeps: files are no longer typechecked twice, and the project-wide use list is built once. `--api-changes` reads a referencing project only when its sources name the declaration.

 0.8.40: FR0055 stays quiet on a catch-all with a `when` guard, on the exception or on state (`with _ when stopping -&gt; ()`); only `when true` is still noted.

 0.8.39: `--define` (and `&quot;defines&quot;` in fsharprefactor.json) defines preprocessor symbols for the whole run: every MSBuild, script and `--parse-only` compilation. A script&apos;s `#r` of the project counts only where its `#if` nesting is live; one under an undefined `#if` names the symbol to pass, and one naming a missing build is read against the project&apos;s sources.

 0.8.38: `--api-changes` typechecks only the scripts whose `#load` chain can reach the project&apos;s sources, read from their text first; a tree of example scripts no longer stalls the run in silence, and both script phases say what they are waiting on. A git worktree nested inside its own repository (`.claude/worktrees/...`) is no longer swept as more of the tree; a worktree beside its repository and a submodule still are.

 0.8.37:FR0118 passes the token only to work that is waited for (`do!`, `let!`, `return!`, `match!`, returned, blocked on, combined); fire-and-forget calls (`|&gt; ignore`, `|&gt; Async.Start`, a bare statement, a store) stay as written.

 0.8.36: FR0015 numbers a function&apos;s second regex (`postcodeRegex2`) before falling back to the function&apos;s whole name (GitHub PRs #7, #8). FR0168 takes a user member named like a throwing BCL one (`Get`, `First`, `Last`) as a read and offers the TryParse fix; BCL and FSharp.Core throwing names and user `Parse`/`Single`/indexers still keep the try. Tests: a failing typecheck or parse assertion lists the compiler errors; the README check accepts CRLF; legacy .NET Framework tests run on Windows only. Packaging: every pack writes a `.snupkg` symbol package, the analyzers package&apos;s pdbs included.</PackageReleaseNotes>
    <Authors>Tuomas Hietanen</Authors>
    <PackageProjectUrl>https://github.com/Thorium/fsharp-refactor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Thorium/fsharp-refactor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;analyzers;refactoring;codefix;ionide;fsautocomplete</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <!-- analyzers are build-time tools: nothing flows to the consumer's output -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- analyzer packages intentionally have no lib/ folder -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <!-- the same analyzers built against FSharp.Analyzers.SDK 0.35.0 — the
         version stock Ionide's FsAutoComplete bundles. The SDK loads only
         analyzers built against its own version and skips the rest with a
         log line, so shipping both assemblies side by side lets every host
         pick the one it can use: stock Ionide loads the .Ionide.dll, the
         CLI and newer FsAutoComplete load the main one. -->
    <None
      Include="..\FSharp.Refactor.Analyzers.Ionide\bin\$(Configuration)\net8.0\FSharp.Refactor.Analyzers.Ionide.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/fs"
      Visible="false" />
    <None
      Include="bin\$(Configuration)\net8.0\FSharp.Refactor.Analyzers.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/fs"
      Visible="false" />
    <None
      Include="bin\$(Configuration)\net8.0\FSharp.Refactor.Analyzers.xml"
      Pack="true"
      PackagePath="analyzers/dotnet/fs"
      Visible="false" />
  </ItemGroup>

  <!-- The symbol package: NuGet puts a pdb into the .snupkg only beside build
       output it packs itself, and IncludeBuildOutput=false packs none, so the
       .snupkg comes out empty. After pack both analyzers' pdbs are added to it
       at their dlls' path in the .nupkg, where the symbol server matches them. -->
  <UsingTask TaskName="AddPdbToSymbolPackage" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Archive ParameterType="System.String" Required="true" />
      <Pdb ParameterType="System.String" Required="true" />
      <EntryName ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (var zip = ZipFile.Open(Archive, ZipArchiveMode.Update))
        {
            var existing = zip.GetEntry(EntryName);
            if (existing != null) existing.Delete();
            zip.CreateEntryFromFile(Pdb, EntryName);

            var types = zip.GetEntry("[Content_Types].xml");
            if (types != null)
            {
                string xml;
                using (var reader = new StreamReader(types.Open())) xml = reader.ReadToEnd();
                if (xml.IndexOf("Extension=\"pdb\"", System.StringComparison.OrdinalIgnoreCase) < 0)
                {
                    xml = xml.Replace("</Types>", "<Default Extension=\"pdb\" ContentType=\"application/octet\" /></Types>");
                    types.Delete();
                    var rewritten = zip.CreateEntry("[Content_Types].xml");
                    using (var writer = new StreamWriter(rewritten.Open())) writer.Write(xml);
                }
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="AnalyzerSymbolsIntoSymbolPackage" AfterTargets="Pack" Condition="'$(IncludeSymbols)' == 'true' and '$(SymbolPackageFormat)' == 'snupkg'">
    <PropertyGroup>
      <_SymbolPackagePath>$([MSBuild]::EnsureTrailingSlash('$(PackageOutputPath)'))$(PackageId).$(PackageVersion).snupkg</_SymbolPackagePath>
    </PropertyGroup>
    <AddPdbToSymbolPackage
      Archive="$(_SymbolPackagePath)"
      Pdb="$(MSBuildProjectDirectory)\bin\$(Configuration)\net8.0\FSharp.Refactor.Analyzers.pdb"
      EntryName="analyzers/dotnet/fs/FSharp.Refactor.Analyzers.pdb" />
    <AddPdbToSymbolPackage
      Archive="$(_SymbolPackagePath)"
      Pdb="$(MSBuildProjectDirectory)\..\FSharp.Refactor.Analyzers.Ionide\bin\$(Configuration)\net8.0\FSharp.Refactor.Analyzers.Ionide.pdb"
      EntryName="analyzers/dotnet/fs/FSharp.Refactor.Analyzers.Ionide.pdb" />
  </Target>

  <ItemGroup>
    <!-- build ordering only: the packed .Ionide.dll must exist -->
    <ProjectReference
      Include="..\FSharp.Refactor.Analyzers.Ionide\FSharp.Refactor.Analyzers.Ionide.fsproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

