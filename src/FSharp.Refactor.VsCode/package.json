{
    "name": "fsharp-refactor-vscode",
    "displayName": "FSharp.Refactor",
    "description": "Functional refactoring hints with one-click fixes for F# - wires the FSharp.Refactor analyzers into Ionide. The tool clarifies the (agent-generated or old) code's intent, reduces non-alphanumeric noise, and uses built-in .NET libraries more efficiently.",
    "version": "0.8.56",
    "publisher": "TuomasHietanen",
    "license": "Unlicense",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/Thorium/fsharp-refactor"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Linters",
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "fsharp",
        "F#",
        "refactoring",
        "analyzers",
        "quickfix",
        "codefix",
        "code fix",
        "static analysis",
        "code quality",
        "linter",
        "lint",
        "ionide",
        "fsautocomplete",
        "functional",
        "functional programming",
        "idiomatic",
        "performance",
        "security",
        "async",
        "cleanup",
        "fsharp-refactor",
        "dotnet",
        ".NET"
    ],
    "extensionDependencies": [
        "Ionide.Ionide-fsharp"
    ],
    "activationEvents": [
        "onLanguage:fsharp",
        "workspaceContains:**/*.fsproj",
        "workspaceContains:**/*.fsx"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "fsharpRefactor.enable",
                "title": "FSharp.Refactor: Wire analyzers into Ionide"
            },
            {
                "command": "fsharpRefactor.disable",
                "title": "FSharp.Refactor: Remove analyzers from Ionide settings"
            },
            {
                "command": "fsharpRefactor.status",
                "title": "FSharp.Refactor: Status (versions and wiring)"
            },
            {
                "command": "fsharpRefactor.run",
                "title": "FSharp.Refactor: Run the tool on this workspace"
            },
            {
                "command": "fsharpRefactor.runApiChanges",
                "title": "FSharp.Refactor: Run the tool with --api-changes (rewrites the public surface)"
            },
            {
                "command": "fsharpRefactor.report",
                "title": "FSharp.Refactor: Write a SARIF report for this workspace"
            },
            {
                "command": "fsharpRefactor.createConfig",
                "title": "FSharp.Refactor: Create or open the configuration file"
            },
            {
                "command": "fsharpRefactor.reviewNotes",
                "title": "FSharp.Refactor: Review advisory notes as a page"
            },
            {
                "command": "fsharpRefactor.useNewerFsac",
                "title": "FSharp.Refactor: Use FsAutoComplete 0.87+ (the analyzers need it)"
            },
            {
                "command": "fsharpRefactor.useBundledFsac",
                "title": "FSharp.Refactor: Use Ionide's bundled FsAutoComplete again"
            }
        ]
    },
    "fsharpRefactorBuild": {
        "analyzers": "0.8.56",
        "sdks": "0.43",
        "built": "2026-11-17 11:56 UTC"
    },
    "scripts": {
        "compile": "tsc -p ."
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.75.0",
        "@vscode/vsce": "^3.1.0",
        "typescript": "^5.4.0"
    }
}
