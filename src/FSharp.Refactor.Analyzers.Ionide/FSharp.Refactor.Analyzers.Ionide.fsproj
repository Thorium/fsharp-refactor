<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- the SAME analyzers compiled against FSharp.Analyzers.SDK 0.35.0 —
         the version stock Ionide's FsAutoComplete bundles. The SDK loads
         only analyzers built against its own version and skips the rest,
         so the package ships BOTH assemblies side by side and every host
         picks the one it can use. Distinct assembly name so the two can
         live in one folder. -->
    <AssemblyName>FSharp.Refactor.Analyzers.Ionide</AssemblyName>
    <DefineConstants>$(DefineConstants);ANALYZERS_SDK_0_35</DefineConstants>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!-- Version pinning is per-SDK here, unlike Directory.Build.props -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FSharp.Refactor.Analyzers\RuleCatalog.fs" />
    <Compile Include="..\FSharp.Refactor.Analyzers\Text.fs" />
    <Compile Include="..\FSharp.Refactor.Analyzers\Visibility.fs" />
    <Compile Include="..\FSharp.Refactor.Analyzers\AstIndex.fs" />
    <Compile Include="..\FSharp.Refactor.Analyzers\Configuration.fs" />
    <Compile Include="..\FSharp.Refactor.Analyzers\ProjectSources.fs" />
    <Compile Include="..\FSharp.Refactor.Analyzers\SignatureFile.fs" />
