<Project>

  <!-- One version for the whole solution: the analyzers package and the
       fsharp-refactorings-apply tool embed each other's behavior, so they
       release in lockstep. Bump HERE (and only here) before tagging. -->
  <PropertyGroup>
    <Version>0.8.41</Version>
    <!-- a .snupkg beside every .nupkg: `dotnet nuget push *.nupkg` sends it
         to the symbol server with its package -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
